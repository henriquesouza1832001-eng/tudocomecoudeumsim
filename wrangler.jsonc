{
    "name":  "tudocomecoudeumsim",
    "pages_build_output_dir":  "./dist",
    "compatibility_date":  "2026-10-12",
    "vars": {
        "ACCESS_TEAM_DOMAIN": "https://quarta-amstel-pages.cloudflareaccess.com",
        "ACCESS_APPLICATION_AUD": "1db573da6440a8939d5a164852d6ff202d9e1721fb43cc219b6720740e496e3e"
    },
    "r2_buckets": [
        {
            "binding": "GUEST_PHOTOS",
            "bucket_name": "tudocomecoudeumsim-guest-photos"
        }
    ],
    "d1_databases":  [
                         {
